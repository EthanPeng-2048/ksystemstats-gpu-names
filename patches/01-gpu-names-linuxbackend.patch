+// PCI Device class strings
+static const char *VGAController = "0x030000";
+static const char *threeDController = "0x030200";
+static const char *displayController = "0x038000";
+
+// 回移上游 commit 62f949813a（6.7.0）：设备型号名从 udev 数据库读
+// （systemd 的 pci hwdb 提供 ID_MODEL_FROM_DATABASE），读不到才回退 "GPU n"。
+// 上游把这段放进 KSysGuard::gpuName()，这里原地实现，避免连带升级 libksysguard。
+static QString gpuModelName(udev_device *pciDevice, int gpuNumber)
+{
+    if (pciDevice) {
+        const char *model = udev_device_get_property_value(pciDevice, "ID_MODEL_FROM_DATABASE");
+        if (model && *model) {
+            return QString::fromLocal8Bit(model);
+        }
+        const char *vendor = udev_device_get_property_value(pciDevice, "ID_VENDOR_FROM_DATABASE");
+        if (vendor && *vendor) {
+            return i18nc("@title %1 is vendor name", "%1 GPU", QString::fromLocal8Bit(vendor));
+        }
+    }
+    return i18nc("@title %1 is GPU number", "GPU %1", gpuNumber + 1);
+}
 
